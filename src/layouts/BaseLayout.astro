---
import '../styles/global.css';
import { ViewTransitions } from 'astro:transitions';
import Header from '../components/Header.astro';
import MusicPlayer from '../components/MusicPlayer.astro';

interface Props {
  title?: string;
  description?: string;
  shell?: 'full' | 'page';
}

const {
  title = 'PERSONAL TERMINAL',
  description =
    '一个 Y2K 风格的个人站点 — 笔记、实验场、像素终端。Best viewed in 1024×768.',
  shell = 'page',
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/og-cover.png" />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <ViewTransitions />
    <title>{title}</title>
  </head>
  <body class={`relative min-h-screen overflow-x-hidden ${shell === 'full' ? 'bg-black' : ''}`}>
    <Header />
    {
      shell === 'full' ? (
        <slot />
      ) : (
        <div class="mx-auto w-full max-w-[1200px] px-5 pb-10 pt-28 sm:px-8 lg:px-14 xl:px-20">
          <slot />
        </div>
      )
    }
    <MusicPlayer />
  </body>
</html>
