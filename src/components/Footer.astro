---
const year = new Date().getFullYear();
---

<footer class="relative z-30 border-t border-neon-cyan/35 bg-black/45 px-5 py-6 backdrop-blur-sm sm:px-8 lg:px-10">
  <div class="mx-auto flex max-w-[1280px] flex-col items-center justify-between gap-4 md:flex-row">
    <p class="font-accent text-[0.6rem] uppercase tracking-widest text-type-dim">
      © {year} TRANICI. <span class="text-neon-cyan/70">best viewed in 1024x768.</span>
    </p>

    <ul class="flex items-center gap-4 text-neon-cyan/80">
      <li>
        <a href="/posts" aria-label="Posts" class="hover:text-neon-magenta">
          <svg viewBox="0 0 16 16" width="18" height="18" shape-rendering="crispEdges" fill="currentColor">
            <rect x="2" y="3" width="12" height="2" />
            <rect x="2" y="7" width="12" height="2" />
            <rect x="2" y="11" width="8" height="2" />
          </svg>
        </a>
      </li>
      <li>
        <a href="mailto:hi@tranici.dev" aria-label="Mail" class="hover:text-neon-magenta">
          <svg viewBox="0 0 16 16" width="18" height="18" shape-rendering="crispEdges" fill="currentColor">
            <rect x="1" y="3" width="14" height="1" />
            <rect x="1" y="12" width="14" height="1" />
            <rect x="1" y="3" width="1" height="10" />
            <rect x="14" y="3" width="1" height="10" />
            <rect x="2" y="4" width="2" height="1" />
            <rect x="4" y="5" width="2" height="1" />
            <rect x="6" y="6" width="2" height="1" />
            <rect x="8" y="6" width="2" height="1" />
            <rect x="10" y="5" width="2" height="1" />
            <rect x="12" y="4" width="2" height="1" />
          </svg>
        </a>
      </li>
      <li>
        <a href="/tools" aria-label="Tools" class="hover:text-neon-magenta">
          <svg viewBox="0 0 16 16" width="18" height="18" shape-rendering="crispEdges" fill="currentColor">
            <rect x="3" y="2" width="10" height="2" />
            <rect x="5" y="4" width="6" height="2" />
            <rect x="7" y="6" width="2" height="8" />
            <rect x="4" y="12" width="8" height="2" />
          </svg>
        </a>
      </li>
    </ul>

    <p class="font-accent text-[0.6rem] uppercase tracking-widest text-type-dim">
      visitors:
      <span class="ml-1 font-pixel text-[0.55rem] tabular-nums text-neon-yellow">00042</span>
    </p>
  </div>
</footer>
