---
const navItems = [
  { label: 'HOME', href: '/' },
  { label: 'JOURNAL', href: '/posts' },
  { label: 'ABOUT', href: '/about' },
  { label: 'MEDIA', href: '/media' },
  { label: 'TOOLS', href: '/tools' },
];
---

<header class="pointer-events-none fixed inset-x-0 top-0 z-50 px-5 py-5 sm:px-8 lg:px-10 lg:py-8 ">
  <div class="mx-auto flex w-full max-w-[1280px] items-center justify-between gap-3">
    <a href="/" class="group pointer-events-auto flex shrink-0 items-center gap-3">
      <img
        src="/art/tranici-logo.png"
        alt="TRANICI"
        width="32"
        height="32"
        class="h-8 w-8 transition-transform duration-200 group-hover:rotate-[12deg] group-hover:scale-110"
      />
      <span class="font-display text-[17px] font-semibold tracking-tight text-white">
        TRANICI<sup class="ml-0.5 align-super font-accent text-[8px] tracking-[0.12em] text-neon-cyan">TM</sup>
      </span>
    </a>

    <nav class="liquid-glass pointer-events-auto hidden items-center gap-1 rounded-full px-2 py-2 md:flex">
      {
        navItems.map((item, i) => (
          <a
            href={item.href}
            class="nav-link rounded-full px-4 py-1.5 text-[11px] font-medium tracking-[0.12em] text-white/90 transition-colors duration-200 hover:text-white"
            data-nav-idx={String(i + 1).padStart(2, '0')}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="hidden items-center gap-2 font-terminal text-base text-type-dim lg:flex">
      <span class="h-1.5 w-1.5 animate-pulse bg-neon-lime" aria-hidden="true"></span>
      <span id="header-clock" class="tabular-nums tracking-wider">--.--.-- ▒ --:--:--</span>
    </div>

    <a
      href="/tools"
      class="liquid-glass pointer-events-auto shrink-0 rounded-full px-4 py-2.5 font-display text-[11px] font-medium tracking-[0.12em] text-white/90 transition-colors duration-200 hover:text-white sm:px-5"
    >
      <span class="hidden sm:inline">GET ROAMING</span>
      <span class="sm:hidden">GO</span>
    </a>
  </div>

  <script is:inline data-astro-rerun>
    (function () {
      if (window.__traniciClockTimer) clearInterval(window.__traniciClockTimer);
      const el = document.getElementById('header-clock');
      if (!el) return;
      const pad = (n) => String(n).padStart(2, '0');
      const tick = () => {
        const d = new Date();
        el.textContent =
          `${d.getFullYear()}.${pad(d.getMonth() + 1)}.${pad(d.getDate())} ▒ ` +
          `${pad(d.getHours())}:${pad(d.getMinutes())}:${pad(d.getSeconds())}`;
      };
      tick();
      window.__traniciClockTimer = setInterval(tick, 1000);
    })();
  </script>
</header>
